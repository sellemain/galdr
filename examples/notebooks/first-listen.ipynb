        "# galdr first listen\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Analyze one audio file and assemble a listening-experience prompt.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from galdr import listen\n",
        "\n",
        "a = listen('audio/your-track.mp3', analysis_dir='analysis')\n",
        "a.report\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "prompt = a.to_prompt(template='arc', mode='full')\n",
        "print(prompt[:2000])\n"
      ]
    }
