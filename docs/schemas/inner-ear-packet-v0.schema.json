{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sellemain/galdr/blob/main/docs/schemas/inner-ear-packet-v0.schema.json",
  "title": "Galdr Inner Ear Packet v0",
  "type": "object",
  "required": ["schema", "subject", "witness", "literal_claim_allowed", "full_mix_first", "opening", "hinges", "surface", "uncertainties", "suspect_claims", "assembler_notes"],
  "properties": {
    "schema": {"const": "galdr.inner_ear_packet.v0"},
    "subject": {"type": "object", "required": ["slug"], "properties": {"slug": {"type": "string"}}, "additionalProperties": true},
    "witness": {"type": "object", "required": ["kind", "model"], "properties": {"kind": {"const": "model_audio"}, "model": {"type": "string"}}, "additionalProperties": true},
    "literal_claim_allowed": {"const": false},
    "full_mix_first": {"const": true},
    "opening": {"type": "object"},
    "hinges": {"type": "array", "items": {"$ref": "#/$defs/hinge"}},
    "surface": {"type": "object"},
    "uncertainties": {"type": "array", "items": {"type": "object"}},
    "suspect_claims": {"type": "array", "items": {"type": "object"}},
    "assembler_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true,
  "$defs": {
    "hinge": {
      "type": "object",
      "required": ["time_sec", "kind", "claim", "confidence", "suspect"],
      "properties": {
        "time_sec": {"type": "number", "minimum": 0},
        "kind": {"type": "string"},
        "claim": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "suspect": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
